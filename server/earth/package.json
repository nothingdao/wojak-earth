{
  "name": "earth-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch --env-file=.env --tsconfig tsconfig.json src/index.ts",
    "start": "tsx --tsconfig tsconfig.json src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1042.0",
    "@metaplex-foundation/js": "^0.20.1",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "convex": "^1.28.0",
    "express": "^5.2.1",
    "ws": "^8.18.3",
    "tsx": "^4.20.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.6.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
